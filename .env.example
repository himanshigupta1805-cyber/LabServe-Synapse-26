# LabServe Environment Configuration
# Copy this file to .env and fill in your values

# Google Gemini API Key (required for LLM-powered planning)
GOOGLE_API_KEY=your-google-api-key-here

# LLM Model (default: gemini-2.0-flash)
LABSERVE_MODEL=gemini-3.8-flash

# Checkpoint database path (default: ./checkpoints.db)
CHECKPOINT_DB=./checkpoints.db

# Log level (default: INFO)
LOG_LEVEL=INFO
